{
  "name": "mavin-desktop",
  "private": true,
  "version": "0.2.5",
  "description": "MAVIN.pk offline desktop (pilot)",
  "main": "dist/main.js",
  "scripts": {
    "build": "node scripts/schema.cjs && esbuild src/main.ts src/preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outdir=dist",
    "start": "npm run build && electron .",
    "dist": "npm run build:web && npm run build && electron-builder --win nsis --publish never",
    "build:web": "node scripts/build-web.cjs"
  },
  "devDependencies": {
    "electron": "^38.8.6",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12"
  },
  "productName": "MAVIN Offline",
  "author": "MAVIN.pk",
  "build": {
    "appId": "pk.mavin.offline",
    "productName": "MAVIN Offline",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/offline-public.pem",
        "to": "offline-public.pem"
      },
      {
        "from": "resources/schema.sql",
        "to": "schema.sql"
      },
      {
        "from": "../out",
        "to": "web"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "MAVIN-Offline-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://www.mavin.pk/downloads/windows/"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  }
}
