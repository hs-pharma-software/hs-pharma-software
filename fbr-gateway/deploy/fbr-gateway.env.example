# /etc/mavin-fbr-gateway.env   (chmod 600, owner root)
# Shared secret(s) with MAVIN's server. Same value as FBR_GATEWAY_SECRET on Vercel.
# Generate: openssl rand -base64 48
# During a key change list the new one first, then the old one: NEW,OLD
GATEWAY_SECRETS=

# Listen only on this machine; Caddy in front provides HTTPS.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787

# FBR Digital Invoicing gateway (do not change in production).
FBR_BASE_URL=https://gw.fbr.gov.pk
FBR_TIMEOUT_MS=40000

# Limits
MAX_BODY_BYTES=1000000
RATE_PER_TENANT_PER_MIN=60
RATE_TOTAL_PER_MIN=600
MAX_CLOCK_SKEW_MS=300000

# Outbound IP check (Super Admin > FBR Integration > Check outbound IP)
EGRESS_CHECK_URL=https://api.ipify.org
GATEWAY_VERSION=1.0.0
