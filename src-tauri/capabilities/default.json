{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "fs:default",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-read-recursive",
    "dialog:default",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://*.turso.io/*" },
        { "url": "https://api.cloudinary.com/*" }
      ]
    },
    "os:default"
  ]
}
