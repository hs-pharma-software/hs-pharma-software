{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Billora",
  "version": "0.1.5",
  "identifier": "com.billora.app",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "cross-env TAURI_BUILD=1 npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Billora",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUyQTE2NEZCQTZGQkNENkEKUldScXpmdW0rMlNoVXI4S1BqUktoVkVoWlNHanF4SFVsaEFZZGY2YmlXU0lTWHU4bWdSVjdqNmEK",
      "endpoints": [
        "https://github.com/hs-pharma-software/hs-pharma-software/releases/latest/download/latest.json"
      ],
      "dialog": false,
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
